# =============================================================================
# Travel AI Concierge — Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Langfuse ─────────────────────────────────────────────────────────────────
# MODE A — Local self-hosted (default, started via `make langfuse-up`)
# After starting Langfuse locally, create a project in the UI at
# http://localhost:3000 and copy the keys here.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3000

# MODE B — Langfuse Cloud (https://cloud.langfuse.com)
# To switch, replace all three values above with your Cloud project credentials.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

LANGFUSE_ENABLED=true

# ── LLM Provider (configured in Milestone 2) ─────────────────────────────────
# Supported: mock | anthropic | openai
LLM_PROVIDER=mock
LLM_MODEL=mock

# Uncomment when using a real provider:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=sk-ant-...

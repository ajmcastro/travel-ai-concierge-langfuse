# =============================================================================
# Travel AI Concierge — Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env.
#
#   make env    # does the copy for you
#
# The secrets below are throwaway values meant for a single developer running
# everything on localhost. They are NOT safe to reuse for anything reachable
# from outside your machine. See docs/langfuse.md for how to regenerate them.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Langfuse — application SDK config ────────────────────────────────────────
# MODE A — Local self-hosted (default, started via `make langfuse-up`).
# These match LANGFUSE_INIT_PROJECT_PUBLIC_KEY / _SECRET_KEY below, so the
# keys are valid the moment the stack finishes its first boot — no manual
# UI signup required. See docs/langfuse.md to do it via the UI instead.
LANGFUSE_PUBLIC_KEY=pk-lf-e34cb17005db3c6da69e4bfc55d6dff0
LANGFUSE_SECRET_KEY=sk-lf-14f1567533971fdf0216e22897be64d1
LANGFUSE_HOST=http://localhost:3000

# MODE B — Langfuse Cloud (https://cloud.langfuse.com).
# To switch, replace all three values above with your Cloud project credentials:
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

LANGFUSE_ENABLED=true

# ── LLM Provider (Milestone 2) ────────────────────────────────────────────────
# Supported today: mock | anthropic (openai planned for a later milestone)
LLM_PROVIDER=mock
LLM_MODEL=mock

# Uncomment to use the real Anthropic provider instead of the mock:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=sk-ant-...

# =============================================================================
# Langfuse self-hosted infrastructure (docker-compose.yml, Milestone 1)
# These are consumed by Docker, not by the Python app. Regenerate every
# CHANGEME value with `openssl rand -hex 32` (or -hex 16 where noted) before
# using this anywhere beyond your own machine.
# =============================================================================

# Postgres — relational metadata (projects, users, prompts, datasets)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=a24a1c35cfcf7f1f50f9898d016bc5af
POSTGRES_DB=postgres

# ClickHouse — trace/observation event storage
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=eb1c5d60d532a889d6437a59760c14b3

# Redis — async ingestion queue
REDIS_AUTH=bf5a2e9adb510028adcaccda1de66eea

# MinIO — S3-compatible blob storage
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=3e70c64d754d1146233ab18ce40aacbb

# langfuse-web — app-level secrets
# SALT:           any random string, used to hash API keys before storage
# ENCRYPTION_KEY: exactly 64 hex chars (32 bytes) — `openssl rand -hex 32`
# NEXTAUTH_SECRET: session cookie signing key — `openssl rand -hex 32`
SALT=3157160a5bc122c8e7dcf43912573b85
ENCRYPTION_KEY=d7209ff63112b0623c8c7dc714e27ee4a32d7427347bb9de46329a2d196d88e4
NEXTAUTH_SECRET=153601a381f24b342bf1b3566ca5b661e570695d01103763439f6f47d2cc4430

# Host port for the Langfuse UI. If 3000 is already taken on your machine
# (another app, another docker-compose stack), override both of these to the
# same alternate port — e.g. 3001 — and update LANGFUSE_HOST above to match.
LANGFUSE_WEB_PORT=3000
NEXTAUTH_URL=http://localhost:3000

# ── Headless initialization ───────────────────────────────────────────────────
# Provisions an org, project, user, and API key pair automatically on the
# FIRST boot of langfuse-web only (subsequent boots are no-ops). This is what
# makes LANGFUSE_PUBLIC_KEY/_SECRET_KEY above valid without a manual UI step.
# See: https://langfuse.com/self-hosting/administration/headless-initialization
LANGFUSE_INIT_ORG_ID=travel-ai-concierge
LANGFUSE_INIT_ORG_NAME=Travel AI Concierge
LANGFUSE_INIT_PROJECT_ID=travel-ai-concierge-dev
LANGFUSE_INIT_PROJECT_NAME=Travel AI Concierge (dev)
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-e34cb17005db3c6da69e4bfc55d6dff0
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-14f1567533971fdf0216e22897be64d1
LANGFUSE_INIT_USER_EMAIL=dev@example.com
LANGFUSE_INIT_USER_NAME=Local Dev
LANGFUSE_INIT_USER_PASSWORD=8167ee5066c9948b8138b3e6
